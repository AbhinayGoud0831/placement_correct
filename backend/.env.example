# PostgreSQL connection string
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://placement_user:placement_pass@localhost:5432/placement_db

# JWT secret key — use a long random string in production
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string-minimum-32-characters

# JWT token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama server endpoint (local or remote)
OLLAMA_HOST=http://localhost:11434

# Ollama model to use for resume/JD extraction
# Must be pulled first: ollama pull qwen2.5
OLLAMA_MODEL=qwen2.5

# Sentence-transformers embedding model for semantic matching
# Downloaded automatically on first use; ~100MB
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Directory to store uploaded resume files
UPLOAD_DIR=./uploads

# Public job sources used by Discovery -> Refresh Live Jobs
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
JOB_SOURCE_TIMEOUT=15
LIVE_JOB_LIMIT=50
